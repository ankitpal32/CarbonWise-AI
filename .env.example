# ==============================================================================
# CarbonWise AI — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-SIDE SECRETS (Never prefix with VITE_, Never commit real values)
# Used by Vercel Serverless Function /api/coach and local Vite dev proxy
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# CLIENT-SIDE CONFIGURATION (Optional public variables)
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (Optional)
# If omitted, CarbonWise AI automatically falls back to Open-Meteo free API (no key required)
# VITE_OPENWEATHER_API_KEY=
