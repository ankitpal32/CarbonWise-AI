# ==============================================================================
# CarbonWise AI — Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-SIDE CONFIGURATION (Never prefix with VITE_, Never commit secrets)
# Used by Vercel Serverless Function (/api/coach) and Vite local dev proxy
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Override Gemini Model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# CLIENT-SIDE CONFIGURATION (Optional public variables)
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key (Optional)
# If omitted, CarbonWise AI automatically uses Open-Meteo free API (no key required)
# VITE_OPENWEATHER_API_KEY=
